{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lzj960515/semantic-atlas/main/schemas/evaluation-run-v1.schema.json",
  "title": "Semantic Atlas evaluation run v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "runId": {
      "$ref": "#/$defs/__schema1"
    },
    "caseId": {
      "$ref": "#/$defs/__schema2"
    },
    "mode": {
      "$ref": "#/$defs/__schema3"
    },
    "fixtureRevision": {
      "$ref": "#/$defs/__schema4"
    },
    "agent": {
      "$ref": "#/$defs/__schema5"
    },
    "protocol": {
      "$ref": "#/$defs/__schema6"
    },
    "startedAt": {
      "$ref": "#/$defs/__schema10"
    },
    "finishedAt": {
      "$ref": "#/$defs/__schema11"
    },
    "observations": {
      "$ref": "#/$defs/__schema12"
    },
    "answer": {
      "$ref": "#/$defs/__schema14"
    },
    "adjudication": {
      "$ref": "#/$defs/__schema15"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "caseId",
    "mode",
    "fixtureRevision",
    "agent",
    "protocol",
    "startedAt",
    "finishedAt",
    "observations",
    "answer",
    "adjudication"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "number",
      "const": 1
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "string",
      "minLength": 1
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "no-atlas",
        "atlas"
      ]
    },
    "__schema4": {
      "type": "string",
      "minLength": 1
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "freshContext": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "product",
        "model",
        "freshContext"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "runnerVersion": {
          "type": "string",
          "minLength": 1
        },
        "fixtureCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "instructionsHash": {
          "$ref": "#/$defs/__schema7"
        },
        "toolPolicyHash": {
          "$ref": "#/$defs/__schema7"
        },
        "oracleHidden": {
          "type": "boolean",
          "const": true
        },
        "commandAuditPassed": {
          "type": "boolean",
          "const": true
        },
        "commandAudit": {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "fresh-agent-shell-allowlist-v4"
            },
            "commands": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema8"
              }
            }
          },
          "required": [
            "policy",
            "commands"
          ],
          "additionalProperties": false
        },
        "skillDiscovery": {
          "type": "object",
          "properties": {
            "delivery": {
              "type": "string",
              "const": "repository"
            },
            "promptInjection": {
              "type": "boolean",
              "const": false
            },
            "mainSkillLoaded": {
              "type": "boolean",
              "const": true
            },
            "statusBeforeSource": {
              "type": "boolean",
              "const": true
            },
            "mapBeforeSource": {
              "type": "boolean",
              "const": true
            },
            "decisiveSourceRead": {
              "type": "boolean",
              "const": true
            },
            "decisiveSourceFiles": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema9"
              }
            },
            "conditionalReferences": {
              "type": "object",
              "properties": {
                "snapshotBootstrap": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "outcome": {
                          "type": "string",
                          "const": "not-required"
                        }
                      },
                      "required": [
                        "outcome"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "outcome": {
                          "type": "string",
                          "const": "loaded-after-trigger"
                        },
                        "triggerCommandSequence": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "loadCommandSequence": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "outcome",
                        "triggerCommandSequence",
                        "loadCommandSequence"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "resultRouting": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "outcome": {
                          "type": "string",
                          "const": "not-required"
                        }
                      },
                      "required": [
                        "outcome"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "outcome": {
                          "type": "string",
                          "const": "loaded-after-trigger"
                        },
                        "triggerCommandSequence": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "loadCommandSequence": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "outcome",
                        "triggerCommandSequence",
                        "loadCommandSequence"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "graphPatch": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "outcome": {
                          "type": "string",
                          "const": "not-loaded"
                        }
                      },
                      "required": [
                        "outcome"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "outcome": {
                          "type": "string",
                          "const": "loaded-after-source"
                        },
                        "sourceCommandSequence": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "loadCommandSequence": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "outcome",
                        "sourceCommandSequence",
                        "loadCommandSequence"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "snapshotBootstrap",
                "resultRouting",
                "graphPatch"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "delivery",
            "promptInjection",
            "mainSkillLoaded",
            "statusBeforeSource",
            "mapBeforeSource",
            "decisiveSourceRead",
            "decisiveSourceFiles",
            "conditionalReferences"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "runnerVersion",
        "fixtureCommit",
        "instructionsHash",
        "toolPolicyHash",
        "oracleHidden",
        "commandAuditPassed",
        "commandAudit"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema8": {
      "type": "string",
      "minLength": 1
    },
    "__schema9": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\/)(?!.*\\\\)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\/\\/).+$"
    },
    "__schema10": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "__schema11": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "sourceTokenMethod": {
          "type": "string",
          "minLength": 1
        },
        "sourceOpens": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema13"
          }
        },
        "atlasCalls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "commandSequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "exitCode": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "output": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sequence",
              "command"
            ],
            "additionalProperties": false
          }
        },
        "atlasHandling": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "classification": {
                "type": "string",
                "enum": [
                  "stale",
                  "hypothesis",
                  "unknown",
                  "unsupported",
                  "partial",
                  "insufficient"
                ]
              },
              "action": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sequence",
              "classification",
              "action"
            ],
            "additionalProperties": false
          }
        },
        "skillLoads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "file": {
                "allOf": [
                  {
                    "pattern": "^(?!\\/)(?!.*\\\\)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\/\\/).+$"
                  },
                  {
                    "pattern": "^\\.agents\\/skills\\/semantic-atlas\\/(?:SKILL\\.md|references\\/[a-z0-9-]+\\.md)$"
                  }
                ],
                "$ref": "#/$defs/__schema9"
              }
            },
            "required": [
              "sequence",
              "file"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sourceTokenMethod",
        "sourceOpens",
        "atlasCalls",
        "atlasHandling"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "file": {
          "$ref": "#/$defs/__schema9"
        },
        "sourceTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sequence",
        "file",
        "sourceTokens"
      ],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "response": {
          "type": "string",
          "minLength": 1
        },
        "reportedFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema9"
          }
        },
        "reportedSymbols": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "$ref": "#/$defs/__schema9"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "response",
        "reportedFiles",
        "reportedSymbols"
      ],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "correct": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "failureClassifications": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "missed-dependency",
              "incorrect-answer",
              "stale-knowledge",
              "hypothesis-mishandled",
              "unknown-boundary-mishandled",
              "unsupported-source",
              "protocol-violation"
            ]
          }
        }
      },
      "required": [
        "correct",
        "notes",
        "failureClassifications"
      ],
      "additionalProperties": false
    }
  }
}
