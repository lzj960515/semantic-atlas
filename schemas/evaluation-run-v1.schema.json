{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lzj960515/semantic-atlas/main/schemas/evaluation-run-v1.schema.json",
  "title": "Semantic Atlas evaluation run v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "runId": {
      "$ref": "#/$defs/__schema1"
    },
    "caseId": {
      "$ref": "#/$defs/__schema2"
    },
    "mode": {
      "$ref": "#/$defs/__schema3"
    },
    "fixtureRevision": {
      "$ref": "#/$defs/__schema4"
    },
    "agent": {
      "$ref": "#/$defs/__schema5"
    },
    "startedAt": {
      "$ref": "#/$defs/__schema6"
    },
    "finishedAt": {
      "$ref": "#/$defs/__schema7"
    },
    "observations": {
      "$ref": "#/$defs/__schema8"
    },
    "answer": {
      "$ref": "#/$defs/__schema10"
    },
    "adjudication": {
      "$ref": "#/$defs/__schema11"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "caseId",
    "mode",
    "fixtureRevision",
    "agent",
    "startedAt",
    "finishedAt",
    "observations",
    "answer",
    "adjudication"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "number",
      "const": 1
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "string",
      "minLength": 1
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "no-atlas",
        "atlas"
      ]
    },
    "__schema4": {
      "type": "string",
      "minLength": 1
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "freshContext": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "product",
        "model",
        "freshContext"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "__schema7": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "sourceTokenMethod": {
          "type": "string",
          "minLength": 1
        },
        "sourceOpens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "file": {
                "$ref": "#/$defs/__schema9"
              },
              "sourceTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "sequence",
              "file",
              "sourceTokens"
            ],
            "additionalProperties": false
          }
        },
        "atlasCalls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "command": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sequence",
              "command"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sourceTokenMethod",
        "sourceOpens",
        "atlasCalls"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\/)(?!.*\\\\)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\/\\/).+$"
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "response": {
          "type": "string",
          "minLength": 1
        },
        "reportedFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema9"
          }
        },
        "reportedSymbols": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "$ref": "#/$defs/__schema9"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "response",
        "reportedFiles",
        "reportedSymbols"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "correct": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "correct",
        "notes"
      ],
      "additionalProperties": false
    }
  }
}
