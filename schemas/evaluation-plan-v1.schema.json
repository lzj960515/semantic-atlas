{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lzj960515/semantic-atlas/main/schemas/evaluation-plan-v1.schema.json",
  "title": "Semantic Atlas evaluation plan v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "location",
              "dependency-impact"
            ]
          },
          "frameworks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "nestjs",
                "graphql",
                "typeorm",
                "bullmq"
              ]
            }
          },
          "fixture": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "synthetic"
                  },
                  "repository": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "repository",
                  "revision"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "private"
                  },
                  "repositoryAlias": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "repositoryAlias",
                  "revision"
                ],
                "additionalProperties": false
              }
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "oracle": {
            "type": "object",
            "properties": {
              "acceptanceCriteria": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "requiredFiles": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!\\/)(?!.*\\\\)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\/\\/).+$"
                }
              },
              "requiredSymbols": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!\\/)(?!.*\\\\)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\/\\/).+$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "file",
                    "name"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "acceptanceCriteria",
              "requiredFiles",
              "requiredSymbols"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "frameworks",
          "fixture",
          "prompt",
          "oracle"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "cases"
  ],
  "additionalProperties": false
}
