{
  "name": "semantic-atlas",
  "version": "0.2.0",
  "description": "A local, revision-aware project world model for AI coding agents.",
  "keywords": [
    "ai-agents",
    "code-analysis",
    "knowledge-graph",
    "typescript",
    "cli"
  ],
  "homepage": "https://github.com/lzj960515/semantic-atlas#readme",
  "bugs": {
    "url": "https://github.com/lzj960515/semantic-atlas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzj960515/semantic-atlas.git"
  },
  "license": "MIT",
  "author": {
    "name": "Zijian Liao",
    "email": "lzj960515@163.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "semantic-atlas": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    ".agents/skills/semantic-atlas",
    ".agents/skills/semantic-atlas-insights",
    "dist",
    "docs",
    "schemas",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "packageManager": "pnpm@11.5.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "evaluation:validate": "tsx scripts/validate-evaluation.ts --baseline evaluation/cases/plan.json evaluation/examples/no-atlas-run.json",
    "evaluation:discovery": "tsx scripts/validate-evaluation.ts evaluation/cases/plan.json evaluation/results/fresh-agent-discovery-v5/location-nestjs-provider-atlas.json",
    "evaluation:run": "tsx scripts/run-fresh-agent-evaluation.ts",
    "evaluation:results": "tsx scripts/validate-evaluation.ts --baseline --comparison --report evaluation/results/fresh-agent-v1/report.json evaluation/cases/plan.json evaluation/results/fresh-agent-v1/runs/*.json",
    "validation:backend": "tsx scripts/validate-embedded-backend.ts",
    "package:verify": "tsx scripts/verify-package.ts",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "contracts:check": "tsx scripts/generate-contracts.ts --check",
    "prepack": "tsx scripts/generate-contracts.ts --check && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tiktoken": "1.0.22",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
