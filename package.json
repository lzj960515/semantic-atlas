{
  "name": "semantic-atlas",
  "version": "0.0.0",
  "description": "A local, revision-aware project world model for AI coding agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "semantic-atlas": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "evaluation:validate": "tsx scripts/validate-evaluation.ts --baseline evaluation/cases/plan.json evaluation/examples/no-atlas-run.json",
    "validation:backend": "tsx scripts/validate-embedded-backend.ts",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "contracts:check": "tsx scripts/generate-contracts.ts --check"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
